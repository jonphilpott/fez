# Kernel options on top of x86_64_defconfig. Everything a laptop needs is built in (=y), not left as modules: there is no disk
# to hold modules, and a built-in driver is ready when the screen first needs it.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# graphics: the old Intel and Radeon chips, the virtual cards QEMU offers, and the firmware's own framebuffer as a fallback
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_RADEON=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# keyboards, mice and USB
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# the FAT32 partition on the stick
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# sound and MIDI: Intel and AMD HDA (and its codecs), the older AC97, USB audio and USB MIDI
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_GENERIC=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_RAWMIDI=y
# the initramfs is compressed with zstd: small, and quick to unpack on an old CPU
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# the boot options, built in: a UEFI firmware starts the kernel file with no command line of its own
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=3"
